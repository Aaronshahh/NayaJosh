# ─── Site gate passwords ─────────────────────────────────────────
# bing bong  → RSVP to Sangeet + Wedding Ceremony
# bing       → RSVP to Wedding Ceremony only
# admin      → Guest dashboard
PASSWORD_FULL=bing bong
PASSWORD_WEDDING=bing
PASSWORD_ADMIN=admin

# Secret used to sign session tokens (any long random string)
AUTH_SECRET=replace-with-a-long-random-string

# ─── Supabase ────────────────────────────────────────────────────
# Project Settings → API → Project URL (NOT the /rest/v1 endpoint)
# Example: https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Use the service role key on the server only (never expose to the browser)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Resend (free tier: https://resend.com) ──────────────────────
RESEND_API_KEY=re_xxxxxxxx
# Verified sender, e.g. "Naya & Josh <onboarding@resend.dev>" while testing
RESEND_FROM_EMAIL=Naya & Josh <onboarding@resend.dev>
